@{
    ViewData["Title"] = "Home page";
}

<div class="text-center w-100" style="max-width: 330px; padding: 15px; margin: 120px auto auto;">
    <h1>Аутентификация</h1>
    <form id="login-form" class="d-flex flex-column align-items-center">
        <div class="form-floating" style="width: 100%">
            <input required type="text" name="login" class="form-control" id="floatingInput" placeholder="name@example.com">
            <label for="floatingInput">Login</label>
        </div>
        <div class="form-floating" style="width: 100%">
            <input required type="password" name="password" class="form-control" id="floatingPassword" placeholder="Password">
            <label for="floatingPassword">Password</label>
        </div>

        <button class="w-100 btn btn-lg btn-primary mt-2" type="submit">Войти</button>
    </form>

    <button class="w-100 btn btn-lg btn-success mt-2" type="button" id="refr-button">Обновить токен</button>
</div>